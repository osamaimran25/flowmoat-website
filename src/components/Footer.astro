const socials = Object.entries(SITE.socials)
  .filter(([key, url]) => url && ICONS[key])
  .map(([key, url]) => ({ url, ...ICONS[key] }));
const mailPath =
  "M2 5.5A2.5 2.5 0 0 1 4.5 3h15A2.5 2.5 0 0 1 22 5.5v13a2.5 2.5 0 0 1-2.5 2.5h-15A2.5 2.5 0 0 1 2 18.5v-13zm2.3-.5L12 11.1 19.7 5H4.3zM20 6.4l-7.38 5.85a1 1 0 0 1-1.24 0L4 6.4V18.5c0 .28.22.5.5.5h15a.5.5 0 0 0 .5-.5V6.4z";
const year = new Date().getFullYear();

const columns = [
  {
    title: "Company",
    links: [
      { label: "Services", href: "/services/" },
      { label: "Work", href: "/work/" },
      { label: "Insights", href: "/blog/" },
      { label: "About", href: "/about/" },
      { label: "Book a Free Call", href: "/contact/" },
    ],
  },
  {
    title: "Solutions",
    links: [
      { label: "Hire an AI engineer", href: "/hire-dedicated-ai-engineer/" },
      { label: "AI agent development", href: "/ai-agent-development-company/" },
      { label: "AI chatbot development", href: "/ai-chatbot-development-company/" },
      { label: "RAG chatbots", href: "/rag-chatbot-for-company-documents/" },
      { label: "n8n automation agency", href: "/n8n-automation-agency/" },
    ],
  },
  {
    title: "Markets",
    links: [
      { label: "AI automation, USA", href: "/ai-automation-agency-usa/" },
      { label: "AI development, UK", href: "/ai-development-company-uk/" },
      { label: "AI engineering, Europe", href: "/ai-automation-europe/" },
      { label: "AI for law firms", href: "/ai-automation-for-law-firms/" },
    ],
  },
];
---

<footer class="footer" id="site-footer">
  <div class="container footer-grid">
    <div class="footer-about">
      <a class="brand" href="/">
        <BrandMark gradientId="brandLogoGradientFooter" />
        <span data-brand>Flowmoat</span>
      </a>
      <p>
        Flowmoat is an AI engineering and automation company helping businesses of every size
        modernize operations through intelligent software and automation.
      </p>
      <div class="footer-socials">
        {socials.map((s) => (
          <a class="footer-social" href={s.url} target="_blank" rel="noopener" aria-label={`Flowmoat on ${s.label}`} title={s.label}>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
          </a>
        ))}
        <a class="footer-social" href={`mailto:${SITE.email}`} aria-label="Email Flowmoat" title="Email">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={mailPath} /></svg>
        </a>
      </div>
    </div>
    {columns.map((col) => (
      <nav class="footer-col" aria-label={col.title}>
        <div class="footer-title">{col.title}</div>
        {col.links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
    ))}
  </div>
  <div class="container footer-bottom">
    <span>© {year} Flowmoat. All rights reserved.</span>
    <span>AI engineering and automation for the US, UK and Europe.</span>
  </div>
</footer>
